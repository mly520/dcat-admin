{
    "name": "dcat/admin3",
    "description": "dcat admin3",
    "type": "library",
    "keywords": [
        "dcat",
        "laravel",
        "admin",
        "grid",
        "form",
        "laravel admin"
    ],
    "homepage": "https://github.com/jqhph/dcat-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "jqh",
            "email": "841324345@qq.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0",
        "spatie/eloquent-sortable": "^4.0",
        "doctrine/dbal": "^4.0",
        "dcat/easy-excel": "^1.1"
    },
    "require-dev": {
        "laravel/dusk": "^8.0",
        "phpunit/phpunit": "^11.0",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Dcat\\Admin3\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Dcat\\Admin3\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dcat\\Admin3\\AdminServiceProvider"
            ]
        }
    }
}
